{
  "rewrites": [
    {
      "source": "/pdf/:code",
      "destination": "/api/pdf?code=:code"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/garder-eveil",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/notion.js": {
      "maxDuration": 60
    }
  }
}
